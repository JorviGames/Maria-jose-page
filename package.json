  "main": "index.js",
  "scripts": {
    "sass": "sass --watch src/scss/main.scss:public/css/main.css",
    "server": "nodemon src/app.js",
    "browser-sync": "browser-sync start --proxy localhost:3000 --files \"public/**/*.*, src/views/**/*.*\"",
    "dev": "concurrently \"npm run sass\" \"npm run server\" \"npm run browser-sync\"",
    "bootstrap:js": "copyfiles -u 3 node_modules/bootstrap/dist/js/bootstrap.bundle.min.js public/js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "bootstrap": "^5.3.8",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "browser-sync": "^3.0.4",
    "concurrently": "^10.0.5",
    "copyfiles": "^2.4.1",
    "nodemon": "^3.1.14",
    "sass": "^1.105.1"
  }
}
